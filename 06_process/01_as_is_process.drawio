<mxfile host="app.diagrams.net"><diagram name="As-is process" id="as-isprocess"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="1400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="A" value="Customer complains (phone, app, branch, letter)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="200" height="60" as="geometry"/></mxCell><mxCell id="B" value="Log complaint in case system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="200" height="50" as="geometry"/></mxCell><mxCell id="C" value="Acknowledge to customer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="190" width="200" height="50" as="geometry"/></mxCell><mxCell id="D" value="Can it be fixed by end of day 3?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="270" width="220" height="100" as="geometry"/></mxCell><mxCell id="E" value="Summary resolution sent to customer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="295" width="200" height="50" as="geometry"/></mxCell><mxCell id="F" value="Assign to investigator by queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="410" width="200" height="50" as="geometry"/></mxCell><mxCell id="G" value="Gather information from product teams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="490" width="200" height="50" as="geometry"/></mxCell><mxCell id="H" value="Decide: u